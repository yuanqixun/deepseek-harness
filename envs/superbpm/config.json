{
  "schemaVersion": 1,
  "environment": "superbpm",
  "plugins": {
    "privateMarket": {
      "catalogUrl": "https://hxai2.superbpm.com/app-api/v1/plugins",
      "tenantId": "1",
      "registryUrl": "https://hxflnexus.superbpm.com/repository/npm-group/"
    },
    "dsh-pro-auth": {
      "aicodeApiOrigin": "https://hxai2.superbpm.com",
      "autoLlmKeyEnabled": true,
      "llmKeyEnvironment": "superbpm",
      "modelApiKeyEnv": "superbpm"
    }
  },
  "llm-pi-ai": {
    "providers": {
      "local": {
        "displayName": "superbpm",
        "apiKeyEnv": "superbpm",
        "api": "openai-completions",
        "baseURL": "https://litellm.superbpm.com/v1",
        "models": [
          { "id": "hxfl-lite" },
          { "id": "hxfl-pro" }
        ]
      }
    }
  },
  "desktop": {
    "authProvider": "dsh-pro-auth",
    "branding": {
      "displayName": "信舟办公",
      "iconSet": "superbpm"
    },
    "updates": {
      "distribution": "dshwork",
      "checkUrl": "https://hxai2.superbpm.com/app-api/v1/desktop/updates/check",
      "channel": "stable",
      "feedOrigins": ["https://hxai2.superbpm.com"]
    }
  }
}
